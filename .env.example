# Names only. Real values live in Vercel project settings; pull them with
#   vercel link && vercel env pull .env.local
# Anything prefixed VITE_ is compiled into the public bundle, so never put a secret there.
# See docs/ARCHITECTURE.md section 10.

# Browser (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_HIDE_UNREVIEWED=

# Server only (Vercel functions, scripts)
ANTHROPIC_API_KEY=
JEV_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REVIEW_CODE=
ADMIN_CODE=
SUPABASE_SERVICE_ROLE_KEY=
